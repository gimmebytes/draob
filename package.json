{
  "name": "draob-extension",
  "version": "0.1.2",
  "private": true,
  "description": "Browser extension (MV3, Chrome and Firefox) for managing passwords of Miro boards.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --browser firefox",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\"",
    "test": "jest",
    "licenses": "node scripts/check-licenses.js",
    "coverage": "jest --coverage",
    "version": "node scripts/sync-manifest-version.js && git add public/manifest.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.2.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
